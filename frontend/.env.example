# Empty for a root-hosted app (typical Render static site); use /spandan only for subpath hosting.
VITE_BASE_PATH=

# Set both to the Render backend. VITE_API_URL includes /api; Socket.IO uses the backend origin.
# VITE_API_URL=https://your-backend.onrender.com/api
# VITE_SOCKET_URL=https://your-backend.onrender.com
# These values are public and must never contain secrets.
